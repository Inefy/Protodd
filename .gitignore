# Build output
/build/
/out/
/dist/
/artifacts/
/.cache/
/CMakeUserPresets.json

# IDEs and compilers
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.obj
*.pdb
*.ilk
*.dll
*.exe
*.lib
*.exp

# BWAPI runtime output
/bwapi-data/logs/
/bwapi-data/read/
/bwapi-data/write/
*.rep

# Local game data and maps are not redistributable
/StarCraft/
/maps/
*.mpq

# Local ladder vault. Third-party bots, tournament-manager binaries, maps,
# match results, replays, and machine-specific configuration must never ship.
/ladder/bots/
/ladder/manager/
/ladder/maps/
/ladder/runs/
/ladder/reports/
/ladder/ladder.local.json
/ladder/*.db
/ladder/*.sqlite*

# Python helper caches
__pycache__/
*.py[cod]
